#include <iostream>
#include <vector>
#include <chrono>
#include <random>
#include <algorithm>
using namespace std;
using namespace chrono;

void bubbleSort(vector<int>& a) {
    int n = a.size();
    for (int i = 0; i < n - 1; i++) {
        bool swapped = false;
        for (int j = 0; j < n - i - 1; j++) {
            if (a[j] > a[j + 1]) {
                swap(a[j], a[j + 1]);
                swapped = true;
            }
        }
        if (!swapped) break;
    }
}

int main() {
    const int N = 100000;
    mt19937 rng(42);
    uniform_int_distribution<int> dist(0, 1000000);
    vector<int> a(N);
    for (int& x : a) x = dist(rng);

    auto start = high_resolution_clock::now();
    bubbleSort(a);
    auto end = high_resolution_clock::now();

    cout << "Bubble Sort, size " << N << endl;
    cout << "Sorted: " << (is_sorted(a.begin(), a.end()) ? "yes" : "no") << endl;
    cout << "Time taken: " << duration<double>(end - start).count() << " seconds" << endl;
    return 0;
}
